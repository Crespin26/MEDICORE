# Copy privately to /srv/medicore/shared/.env, replace placeholders, chmod 0640.
# Never regenerate APP_KEY when importing existing encrypted data.
APP_NAME=MediCore
APP_ENV=production
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://clinic.example.org
APP_TIMEZONE=UTC
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
DB_DATABASE=/srv/medicore/shared/database/database.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# No proxy for the supplied Nginx -> PHP-FPM profile.
# With a TLS load balancer, list its actual IP/CIDR and restrict origin ingress.
TRUSTED_PROXIES=

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=clinic@example.org
MAIL_FROM_NAME=MediCore

CLINIC_TIMEZONE=Africa/Porto-Novo
CLINIC_CURRENCY=XOF
MEDICORE_BACKUP_KEY=
VITE_APP_NAME=MediCore
